# Install (run by hand, not by this repo):
#   mkdir -p ~/.config/systemd/user && ln -sf <repo>/systemd/synopsis.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now synopsis.service

[Unit]
Description=synopsis, mission control for hyprland
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/qs -c synopsis
# a crash must not leave the wallpaper covering the desktop. only the cover
# requests go, the wallpaper's own state files stay (%t is the runtime dir)
ExecStopPost=/usr/bin/find %t -maxdepth 1 -name eco-cover-*.json ! -name eco-cover-state-*.json -delete
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
